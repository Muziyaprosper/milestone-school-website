___CSS_LOADER_EXPORT___.push([module.id, `.student-fees-page .student-fees-card {
  border: 1px solid #e2e8f0;
  background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}

.student-fee-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 6px;
  font-size: 12px;
  color: #64748b;
}

.status-pill {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  border: 1px solid transparent;
}

.status-paid {
  background: #ecfdf3;
  color: #047857;
  border-color: #bbf7d0;
}

.status-partial,
.status-partially-paid {
  background: #fef3c7;
  color: #b45309;
  border-color: #fde68a;
}

.status-pending,
.status-unpaid {
  background: #fff1f2;
  color: #be123c;
  border-color: #fecdd3;
}

.status-overdue {
  background: #fee2e2;
  color: #b91c1c;
  border-color: #fecaca;
}

.status-unknown {
  background: #e2e8f0;
  color: #334155;
  border-color: #cbd5f5;
}

.student-fee-progress {
  margin-top: 12px;
  display: grid;
  gap: 8px;
}

.student-fee-progress-bar {
  width: 100%;
  height: 10px;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
}

.student-fee-progress-bar span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #14b8a6, #22c55e);
  border-radius: 999px;
}

.student-fee-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  color: #64748b;
}

.student-fee-items {
  padding: 10px 12px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px dashed #e2e8f0;
}

.student-fee-payments {
  padding: 10px 12px;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

.student-fees-filters {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
}

.student-fees-filter-label {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #64748b;
  margin-bottom: 6px;
  font-weight: 700;
}

@media (max-width: 640px) {
  .student-fee-progress-meta {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
}
