:root {
  --msg-primary: #0084ff;
  --msg-accent: #00b2ff;
  --msg-hover: #f0f2f5;
  --msg-active: #e7f3ff;
  --msg-border: #e5e7eb;
  --msg-text-main: #050505;
  --msg-text-muted: #65676b;
  --msg-sidebar-w: 320px;
  --z-modal: 2000;
}

.messages-layout-new {
  display: flex;
  height: calc(100vh - 84px);
  background: #f0f2f5;
  font-family: 'Manrope', 'Helvetica Neue', 'Segoe UI', sans-serif;
  overflow: hidden;
}

/* Sidebar Styling */
.sidebar-container {
  width: var(--msg-sidebar-w);
  min-width: var(--msg-sidebar-w);
  padding: 8px 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--msg-border);
}

.sidebar-top {
  padding: 8px 16px 16px;
}

.sidebar-compose-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 24px;
  background: var(--msg-primary);
  border: none;
  border-radius: 999px;
  box-shadow: 0 12px 24px rgba(0, 132, 255, 0.25);
  font-weight: 600;
  font-size: 14px;
  color: #fff;
  cursor: pointer;
  transition: box-shadow 0.2s;
}

.sidebar-compose-btn:hover {
  box-shadow: 0 16px 28px rgba(0, 132, 255, 0.3);
  background: #0a7cff;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 8px 24px;
  border: none;
  background: transparent;
  color: var(--msg-text-main);
  border-radius: 999px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  text-align: left;
  margin: 4px 12px;
}

.nav-link:hover {
  background: var(--msg-hover);
}

.nav-link.active {
  background: var(--msg-active);
  color: #0a7cff;
  font-weight: 700;
}

/* Main Viewport */
.main-viewport {
  flex: 1 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-left: none;
  position: relative;
}

.main-header {
  height: 64px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  border-bottom: 1px solid var(--msg-border);
  background: #fff;
}

.header-actions-right {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: 12px;
}

.nav-badge {
  margin-left: auto;
  background: var(--msg-primary);
  color: #fff;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
}

.icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: none;
  background: #f0f2f5;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f172a;
}

.icon-btn:hover {
  background: #e4e6eb;
}

.search-box-container {
  flex: 1 1;
  max-width: 720px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: #f0f2f5;
  padding: 10px 16px;
  border-radius: 999px;
  margin-left: 0;
}

.search-box-container input {
  flex: 1 1;
  background: transparent;
  border: none;
  outline: none;
  font-size: 14px;
}

/* Thread List View */
.content-overflow-area {
  flex: 1 1;
  overflow-y: auto;
  background: #fff;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 20px;
  border-bottom: 1px solid #f3f4f6;
  cursor: pointer;
  font-size: 14px;
  transition: background 0.1s;
}

.list-item:hover {
  background: #f0f2f5;
  box-shadow: inset 0 -1px 0 #e5e7eb;
}

.list-item.is-unread {
  background: #f5faff;
  font-weight: 700;
}

.item-sender {
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}

.item-snippet {
  flex: 1 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  gap: 8px;
  color: var(--msg-text-muted);
}

.item-snippet .subject {
  color: var(--msg-text-main);
  font-weight: 600;
}

.item-snippet .dash {
  color: #5f6368;
  margin: 0 4px;
}

.item-snippet .preview {
  color: var(--msg-text-muted);
  font-weight: 400;
}

.item-date {
  width: 80px;
  text-align: right;
  color: var(--msg-text-muted);
  font-size: 12px;
}

.item-avatar {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  background: #dbeafe;
  color: #0a7cff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-content {
  flex: 1 1;
  min-width: 0;
}

.item-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: var(--msg-primary);
}

/* --- Full Thread View (Document Style) --- */
.thread-container-full {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
}

.thread-header-fixed {
  padding: 12px 20px;
  border-bottom: 1px solid var(--msg-border);
  background: #fff;
  display: flex;
  align-items: center;
  gap: 16px;
}

.icon-btn-back {
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: none;
  background: #f0f2f5;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--msg-text-main);
}

.icon-btn-back:hover {
  background: #e4e6eb;
}

.thread-header-title {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1 1;
}

.thread-header-title .avatar {
  width: 44px;
  height: 44px;
  border-radius: 999px;
  background: #dbeafe;
  color: #0a7cff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thread-header-title .details {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.thread-header-title .details .name {
  font-size: 16px;
  font-weight: 700;
  color: var(--msg-text-main);
}

.thread-header-title .details .subject {
  font-size: 13px;
  color: var(--msg-text-muted);
}

.thread-content-full {
  flex: 1 1;
  overflow-y: auto;
  padding: 20px 20px 12px;
  background: #fff;
}

.chat-bubble {
  max-width: 70%;
  width: fit-content;
  padding: 12px 14px;
  border-radius: 18px;
  font-size: 14px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-wrap: break-word;
  position: relative;
  display: inline-flex;
}

.chat-row {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
  align-items: flex-end;
}

.chat-row.sent {
  justify-content: flex-end;
}

.chat-row.received {
  justify-content: flex-start;
}

.chat-row.sent .chat-bubble {
  background: linear-gradient(180deg, #0084ff 0%, #0073ff 100%);
  color: #fff;
  border-bottom-right-radius: 6px;
}

.chat-row.received .chat-bubble {
  background: #e4e6eb;
  color: #050505;
  border-bottom-left-radius: 6px;
}

.chat-meta {
  font-size: 11px;
  color: var(--msg-text-muted);
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.chat-meta .status {
  display: inline-flex;
  align-items: center;
}

.chat-avatar {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  background: #dbeafe;
  color: #0a7cff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}

.chat-composer {
  border-top: 1px solid var(--msg-border);
  padding: 12px 20px;
  display: flex;
  gap: 12px;
  align-items: center;
  background: #fff;
}

.chat-composer textarea {
  flex: 1 1;
  min-height: 42px;
  max-height: 120px;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  padding: 10px 12px;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  background: #f0f2f5;
}

.chat-composer .send-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  background: var(--msg-primary);
  color: #fff;
  border: none;
  border-radius: 999px;
  font-weight: 600;
  cursor: pointer;
}

.chat-composer .send-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.composer-error {
  font-size: 12px;
  color: #b91c1c;
}

/* --- Compose & Reply Modals (Universal Style) --- */
.compose-modal {
  position: fixed;
  bottom: 0;
  right: 80px;
  width: 550px;
  background: #fff;
  border-radius: 12px 12px 0 0;
  box-shadow: 0 8px 10px 1px rgba(0, 0, 0, 0.14), 0 3px 14px 2px rgba(0, 0, 0, 0.12), 0 5px 5px -3px rgba(0, 0, 0, 0.2);
  z-index: var(--z-modal);
  display: flex;
  flex-direction: column;
  border: 1px solid #dadce0;
}

.compose-modal.minimized {
  height: 40px;
  overflow: hidden;
}

.modal-header {
  background: #1877f2;
  color: #fff;
  height: 40px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 12px 12px 0 0;
  cursor: pointer;
}

.modal-header span {
  font-size: 14px;
  font-weight: 500;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.header-actions button {
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  opacity: 0.8;
}

.header-actions button:hover {
  opacity: 1;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
}

.modal-body {
  flex: 1 1;
  display: flex;
  flex-direction: column;
}

.modal-error {
  padding: 8px 16px;
  background: #fde8e8;
  color: #c81e1e;
  font-size: 13px;
  border-bottom: 1px solid #fbd5d5;
}

.modal-field {
  padding: 8px 16px;
  border-bottom: 1px solid #f1f3f4;
  display: flex;
  align-items: center;
  gap: 12px;
}

.modal-field label {
  font-size: 13px;
  color: #5f6368;
  width: 60px;
}

.modal-field input,
.modal-field select {
  flex: 1 1;
  border: none;
  outline: none;
  font-size: 14px;
  padding: 4px 0;
}

.modal-text-area {
  flex: 1 1;
  padding: 16px;
}

.modal-text-area textarea {
  width: 100%;
  height: 350px;
  border: none;
  outline: none;
  resize: vertical;
  font-size: 14px;
  line-height: 1.5;
  font-family: inherit;
}

.modal-footer {
  padding: 12px 16px;
  border-top: 1px solid #f1f3f4;
  display: flex;
  justify-content: flex-start;
}

.modal-send-btn {
  background: var(--msg-primary);
  color: #fff;
  border: none;
  padding: 8px 24px;
  border-radius: 999px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s;
}

.modal-send-btn:hover:not(:disabled) {
  background: #174ea6;
}

.modal-send-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Empty States */
.messages-empty-state {
  flex: 1 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--msg-text-muted);
  gap: 16px;
}

.modern-hero {
  text-align: center;
}

.modern-hero h2 {
  font-size: 24px;
  font-weight: 600;
  color: var(--msg-text-main);
  margin: 0 0 8px;
}

.modern-hero p {
  font-size: 14px;
  color: var(--msg-text-muted);
  margin: 0;
}

.hero-icon-box {
  width: 80px;
  height: 80px;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  color: #1877f2;
  box-shadow: 0 10px 30px rgba(24, 119, 242, 0.16);
}

.unread-banner {
  margin-top: 24px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #e7f3ff;
  border: 1px solid #cfe2ff;
  border-radius: 999px;
  font-size: 13px;
  color: #1877f2;
  font-weight: 600;
}

.spin {
  animation: spin 1s linear infinite;
}

.pro-loader {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 3px solid #e4e6eb;
  border-top-color: #1877f2;
  animation: spin 0.9s linear infinite;
  box-shadow: 0 6px 14px rgba(24, 119, 242, 0.2);
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 768px) {
  .sidebar-container {
    display: none;
  }

  .compose-modal {
    width: 100%;
    right: 0;
    bottom: 0;
    border-radius: 0;
  }

  .thread-title-section {
    padding-left: 0;
  }

  .thread-content-full {
    padding-left: 16px;
  }

  .chat-bubble {
    max-width: 85%;
  }

  .thread-header-fixed {
    padding: 10px 16px;
  }
}

.thread-list-container {
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.thread-list-container .empty-state {
  margin: auto;
  /* Centers horizontally & vertically */
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #6b7280;
  /* Optional muted tone */
}

.thread-list-container .loading-state {
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}
