,gBAAgB;EAChB,qBAAqB;EACrB,oBAAoB;AACtB;;AAEA;EACE,cAAc;EACd,0BAA0B;AAC5B;;AAEA;EACE,cAAc;EACd,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;AAEA;;EAEE,WAAW;EACX,SAAO;EACP,WAAW;EACX,yBAAyB;AAC3B;;AAEA;EACE,kBAAkB;EAClB,cAAc;EACd,yBAAyB;EACzB,qBAAqB;EACrB,gBAAgB;AAClB;;AAEA,8BAA8B;AAC9B;EACE;IACE,yBAAyB;EAC3B;AACF;;AAEA;EACE,kCAAkC;AACpC","sourcesContent":["/* Forgot Password - Modern Styling */\n\n.forgot-container {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;\n  background-color: #f9fafb;\n}\n\n.forgot-card {\n  flex-grow: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n}\n\n.forgot-card > div {\n  width: 100%;\n  max-width: 28rem;\n  background-color: white;\n  border-radius: 0.75rem;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  overflow: hidden;\n  border: 1px solid #f3f4f6;\n}\n\n.forgot-card .top-bar {\n  height: 0.5rem;\n  width: 100%;\n  background-color: #0d9488;\n}\n\n.forgot-card .content {\n  padding: 2.5rem;\n}\n\n.forgot-card .logo-container {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 0.75rem;\n}\n\n.forgot-card .logo-container img {\n  height: 4rem;\n  width: auto;\n  object-fit: contain;\n}\n\n.forgot-title {\n  font-size: 1.5rem;\n  font-weight: 800;\n  color: #1f2937;\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\n.forgot-subtitle {\n  font-size: 0.8125rem;\n  color: #6b7280;\n  text-align: center;\n  margin-bottom: 1.5rem;\n}\n\n@media (max-width: 640px) {\n  .forgot-card {\n    padding: 1rem;\n  }\n\n  .forgot-card .content {\n    padding: 1.5rem;\n  }\n\n  .forgot-card .logo-container img {\n    height: 3rem;\n  }\n\n  .forgot-title {\n    font-size: 1.25rem;\n    margin-bottom: 1.5rem;\n  }\n\n  .forgot-subtitle {\n    font-size: 0.75rem;\n    margin-bottom: 1.25rem;\n  }\n}\n\n.forgot-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.forgot-input {\n  width: 100%;\n  padding: 0.75rem 1rem;\n  border-radius: 0.5rem;\n  border: 1px solid #d1d5db;\n  font-size: 0.8125rem;\n  transition: all 0.2s;\n  outline: none;\n}\n\n@media (max-width: 640px) {\n  .forgot-input {\n    padding: 0.625rem 0.875rem;\n    font-size: 0.75rem;\n    border-radius: 0.375rem;\n  }\n}\n\n.forgot-input:focus {\n  border-color: transparent;\n  box-shadow: 0 0 0 2px rgba(13, 148, 136, 0.2);\n  border-color: #0d9488;\n}\n\n.forgot-role {\n  display: flex;\n  gap: 1.5rem;\n  padding: 1rem;\n  background-color: #f9fafb;\n  border-radius: 0.5rem;\n  border: 1px solid #e5e7eb;\n}\n\n.forgot-role label {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: #374151;\n  cursor: pointer;\n  flex: 1;\n  padding: 0.5rem;\n  border-radius: 0.375rem;\n  transition: all 0.2s;\n}\n\n.forgot-role label:hover {\n  background-color: #f3f4f6;\n}\n\n.forgot-role input[type=\"radio\"] {\n  width: 1rem;\n  height: 1rem;\n  cursor: pointer;\n  accent-color: #0d9488;\n}\n\n.forgot-button {\n  width: 100%;\n  background-color: #0d9488;\n  color: white;\n  font-weight: 700;\n  padding: 0.75rem 1rem;\n  border-radius: 9999px;\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n  transition: all 0.2s;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-size: 0.875rem;\n}\n\n@media (max-width: 640px) {\n  .forgot-button {\n    padding: 0.625rem 0.875rem;\n    font-size: 0.75rem;\n  }\n}\n\n.forgot-button:hover:not(:disabled) {\n  background-color: #0f766e;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  transform: translateY(-2px);\n}\n\n.forgot-button:disabled {\n  opacity: 0.7;\n  cursor: not-allowed;\n  transform: none;\n}\n\n.forgot-note {\n  margin-top: 1rem;\n  font-size: 0.75rem;\n  color: #6b7280;\n  text-align: center;\n  font-style: italic;\n}\n\n.forgot-message {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  border-radius: 0.375rem;\n  text-align: center;\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.forgot-message.success {\n  background-color: #d1fae5;\n  color: #065f46;\n  border: 1px solid #a7f3d0;\n}\n\n.forgot-message.error {\n  background-color: #fee2e2;\n  color: #991b1b;\n  border: 1px solid #fecaca;\n}\n\n.forgot-footer {\n  margin-top: 2rem;\n  text-align: center;\n  font-size: 0.875rem;\n  color: #6b7280;\n}\n\n.forgot-footer a {\n  color: #0d9488;\n  font-weight: 700;\n  text-decoration: none;\n  transition: all 0.2s;\n}\n\n.forgot-footer a:hover {\n  color: #0f766e;\n  text-decoration: underline;\n}\n\n.forgot-divider {\n  margin: 2rem 0;\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.forgot-divider::before,\n.forgot-divider::after {\n  content: '';\n  flex: 1;\n  height: 1px;\n  background-color: #d1d5db;\n}\n\n.forgot-divider span {\n  font-size: 0.75rem;\n  color: #9ca3af;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  font-weight: 600;\n}\n\n/* Loading spinner animation */\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.animate-spin {\n  animation: spin 1s linear infinite;\n}\n"],"sourceRoot":""}]);
