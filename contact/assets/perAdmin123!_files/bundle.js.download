IAChB,kBAAkB;IAClB,kBAAkB;IAClB,gBAAgB;IAChB,cAAc;IACd,yBAAyB;IACzB,qBAAqB;IACrB,yBAAyB;AAC7B;;AAEA;IACI,kBAAkB;IAClB,yBAAyB;IACzB,oBAAoB;IACpB,gBAAgB;IAChB,6BAA6B;IAC7B,gCAAgC;AACpC;;AAEA;IACI,8BAA8B;IAC9B,4BAA4B;AAChC;;AAEA;IACI,+BAA+B;IAC/B,4BAA4B;AAChC;;AAEA;IACI,yBAAyB;AAC7B;;AAEA;IACI,qBAAqB;IACrB,iBAAiB;IACjB,mBAAmB;IACnB,kBAAkB;IAClB,gBAAgB;AACpB;;AAEA;IACI,yBAAyB;IACzB,cAAc;AAClB;;AAEA;;;;;;;;;;;IAWI,yBAAyB;IACzB,cAAc;AAClB;;AAEA;IACI;QACI,aAAa;IACjB;;IAEA;QACI,aAAa;QACb,mBAAmB;QACnB,6BAA6B;IACjC;;IAEA;QACI,kBAAkB;IACtB;AACJ;;AAEA;IACI;QACI,YAAY;IAChB;;IAEA;QACI,aAAa;QACb,mBAAmB;QACnB,6BAA6B;IACjC;;IAEA;QACI,mBAAmB;IACvB;;IAEA;QACI,eAAe;IACnB;;IAEA;QACI,iBAAiB;QACjB,kBAAkB;IACtB;AACJ","sourcesContent":["/* Student Performance Modal Styles */\n.spm-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: rgba(15, 23, 42, 0.5);\n    backdrop-filter: blur(8px);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 2000;\n    padding: 20px;\n    overflow-y: auto;\n    animation: fadeIn 0.2s ease-out;\n}\n\n.spm-modal-content {\n    background-color: #ffffff;\n    width: 100%;\n    max-width: 72rem; /* 1152px - max-w-6xl */\n    border-radius: 16px;\n    padding: 24px;\n    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n    animation: slideUp 0.3s ease-out;\n    position: relative;\n    max-height: calc(90vh - 40px);\n    overflow-y: auto;\n    margin: auto;\n}\n\n.spm-modal-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n    padding-bottom: 12px;\n    border-bottom: 1px solid #f1f5f9;\n}\n\n.spm-title {\n    font-size: 1.125rem;\n    font-weight: 700;\n    color: #0f172a;\n    margin: 0;\n    line-height: 1.3;\n}\n\n.spm-sub {\n    font-size: 0.75rem;\n    color: #64748b;\n    margin: 2px 0 0 0;\n    line-height: 1.4;\n}\n\n.spm-close-btn {\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 8px;\n    border: none;\n    background-color: #f8fafc;\n    color: #64748b;\n    cursor: pointer;\n    transition: all 0.2s;\n    flex-shrink: 0;\n    margin-left: 16px;\n}\n\n.spm-close-btn:hover {\n    background-color: #f1f5f9;\n    color: #0f172a;\n    transform: rotate(90deg);\n}\n\n.close-btn {\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 8px;\n    border: none;\n    background-color: #f8fafc;\n    color: #64748b;\n    cursor: pointer;\n    transition: all 0.2s;\n    flex-shrink: 0;\n    margin-left: 16px;\n}\n\n.close-btn:hover {\n    background-color: #f1f5f9;\n    color: #0f172a;\n    transform: rotate(90deg);\n}\n\n.spm-tabs {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 24px;\n    border-bottom: 2px solid #f1f5f9;\n}\n\n.spm-tab {\n    padding: 12px 20px;\n    background: none;\n    border: none;\n    border-bottom: 2px solid transparent;\n    color: #64748b;\n    font-size: 0.875rem;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.2s;\n    margin-bottom: -2px;\n}\n\n.spm-tab:hover {\n    color: #0f172a;\n    background-color: #f8fafc;\n}\n\n.spm-tab.active {\n    color: #0d9488;\n    border-bottom-color: #0d9488;\n}\n\n.spm-tab-button {\n    padding: 12px 20px;\n    background: none;\n    border: none;\n    border-bottom: 2px solid transparent;\n    color: #64748b;\n    font-size: 0.875rem;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.2s;\n    margin-bottom: -2px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.spm-tab-button:hover {\n    color: #0f172a;\n    background-color: #f8fafc;\n}\n\n.spm-tab-button.active {\n    color: #0d9488;\n    border-bottom-color: #0d9488;\n}\n\n.spm-stats-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n    gap: 12px;\n    margin-bottom: 20px;\n}\n\n.spm-stat-card {\n    padding: 16px;\n    border-radius: 10px;\n    background-color: #f8fafc;\n    border: 1px solid #e2e8f0;\n}\n\n.spm-stat-label {\n    font-size: 0.75rem;\n    color: #64748b;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 8px;\n}\n\n.spm-stat-value {\n    font-size: 1.875rem;\n    font-weight: 700;\n    color: #0f172a;\n}\n\n.spm-attendance-section,\n.spm-results-section {\n    margin-top: 24px;\n}\n\n.spm-loading,\n.spm-empty {\n    text-align: center;\n    padding: 40px;\n    color: #94a3b8;\n    font-size: 0.875rem;\n}\n\n.spm-table-wrap {\n    overflow-x: auto;\n    margin-top: 16px;\n}\n\n.spm-table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0 8px;\n}\n\n.spm-table th {\n    text-align: left;\n    padding: 12px 16px;\n    font-size: 0.75rem;\n    font-weight: 600;\n    color: #94a3b8;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    background-color: #f8fafc;\n}\n\n.spm-table td {\n    padding: 12px 16px;\n    background-color: #ffffff;\n    font-size: 0.8125rem;\n    font-weight: 500;\n    border-top: 1px solid #f8fafc;\n    border-bottom: 1px solid #f8fafc;\n}\n\n.spm-table tr td:first-child {\n    border-left: 1px solid #f8fafc;\n    border-radius: 12px 0 0 12px;\n}\n\n.spm-table tr td:last-child {\n    border-right: 1px solid #f8fafc;\n    border-radius: 0 12px 12px 0;\n}\n\n.spm-table tr:hover td {\n    background-color: #f8fafc;\n}\n\n.spm-score-badge {\n    display: inline-block;\n    padding: 4px 12px;\n    border-radius: 12px;\n    font-size: 0.75rem;\n    font-weight: 700;\n}\n\n.spm-score-badge[data-score] {\n    background-color: #f0fdf4;\n    color: #16a34a;\n}\n\n.spm-score-badge[data-score=\"90\"],\n.spm-score-badge[data-score=\"91\"],\n.spm-score-badge[data-score=\"92\"],\n.spm-score-badge[data-score=\"93\"],\n.spm-score-badge[data-score=\"94\"],\n.spm-score-badge[data-score=\"95\"],\n.spm-score-badge[data-score=\"96\"],\n.spm-score-badge[data-score=\"97\"],\n.spm-score-badge[data-score=\"98\"],\n.spm-score-badge[data-score=\"99\"],\n.spm-score-badge[data-score=\"100\"] {\n    background-color: #f0fdf4;\n    color: #16a34a;\n}\n\n@media (max-width: 768px) {\n    .spm-modal-overlay {\n        padding: 12px;\n    }\n    \n    .spm-modal-content {\n        padding: 24px;\n        border-radius: 16px;\n        max-height: calc(95vh - 24px);\n    }\n    \n    .spm-title {\n        font-size: 1.25rem;\n    }\n}\n\n@media (max-width: 640px) {\n    .spm-modal-overlay {\n        padding: 8px;\n    }\n    \n    .spm-modal-content {\n        padding: 20px;\n        border-radius: 12px;\n        max-height: calc(95vh - 16px);\n    }\n    \n    .spm-title {\n        font-size: 1.125rem;\n    }\n    \n    .spm-tabs {\n        flex-wrap: wrap;\n    }\n    \n    .spm-tab {\n        padding: 8px 12px;\n        font-size: 0.75rem;\n    }\n}\n"],"sourceRoot":""}]);
