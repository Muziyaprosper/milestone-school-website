AAEA;EACE,cAAc;AAChB;;AAEA,mBAAmB;AACnB;EACE;IACE,OAAO;IACP,kBAAkB;EACpB;AACF;;AAEA;EACE;IACE,YAAY;EACd;;EAEA;IACE,mBAAmB;IACnB,gBAAgB;EAClB;;EAEA;IACE,aAAa;EACf;;EAEA;IACE,aAAa;EACf;AACF;;AAEA;EACE;IACE,aAAa;EACf;;EAEA;IACE,yBAAyB;IACzB,YAAY;EACd;AACF","sourcesContent":["/* Navbar - Professional Design System */\n\n:root {\n  --navbar-height: 72px;\n  --navbar-bg: #0f172a;\n  /* match sidebar */\n  --navbar-border: rgba(255, 255, 255, 0.06);\n  --dropdown-bg: rgba(255, 255, 255, 0.95);\n  --dropdown-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);\n  --navbar-hover-glow: 0 12px 28px rgba(2, 6, 23, 0.45);\n}\n\n.navbar {\n  position: fixed;\n  top: 0;\n  right: 0;\n  height: var(--navbar-height);\n  background: linear-gradient(90deg, var(--navbar-bg) 0%, #111827 100%);\n  color: white;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0 1.5rem;\n  z-index: 50;\n  border-bottom: 1px solid var(--navbar-border);\n  box-shadow: 0 1px 3px 0 rgba(2, 6, 23, 0.35), 0 1px 2px -1px rgba(2, 6, 23, 0.35);\n  left: var(--sidebar-width, 240px);\n  transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, background 0.25s ease;\n}\n\n.navbar.full-width {\n  left: 0;\n}\n\n/* No hover glow on navbar */\n\n/* Logo Section */\n.navbar-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-shrink: 0;\n}\n\n.navbar-logo img {\n  width: 40px;\n  height: 40px;\n  object-fit: contain;\n  border-radius: 8px;\n}\n\n.navbar-logo h2 {\n  margin: 0;\n  font-size: 1.25rem;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 240px;\n}\n\n/* Navigation Links */\n.navbar-nav {\n  display: flex;\n  align-items: center;\n  gap: 1.5rem;\n  flex: 1;\n  justify-content: flex-end;\n}\n\n.nav-link {\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: #ffffff;\n  text-decoration: none;\n  transition: transform 0.15s ease;\n  padding: 0.5rem 0.75rem;\n  border-radius: 6px;\n  position: relative;\n  transform-origin: left center;\n}\n\n.navbar .nav-link,\n.navbar .profile-trigger,\n.navbar .navbar-logo h2 {\n  color: #ffffff;\n}\n\n.nav-link:hover {\n  font-weight: 700;\n  transform: scale(1.05);\n  background-color: transparent;\n}\n\n/* User Profile Trigger */\n.profile-trigger {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  cursor: pointer;\n  padding: 0.5rem;\n  border-radius: 10px;\n  transition: transform 0.15s ease;\n  user-select: none;\n  transform-origin: right center;\n}\n\n.profile-trigger:hover {\n  font-weight: 700;\n  transform: scale(1.03);\n  background-color: transparent;\n}\n\n.profile-trigger .user-name {\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.profile-avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 9999px;\n  object-fit: cover;\n  border: 2px solid rgba(255, 255, 255, 0.2);\n}\n\n.chevron-icon {\n  transition: transform 0.2s ease;\n}\n\n.chevron-icon.active {\n  transform: rotate(180deg);\n}\n\n/* Premium Dropdown */\n.navbar-dropdown {\n  position: absolute;\n  top: calc(100% + 0.5rem);\n  right: 0;\n  width: 240px;\n  background-color: var(--dropdown-bg);\n  border-radius: 12px;\n  border: 1px solid rgba(0, 0, 0, 0.05);\n  box-shadow: var(--dropdown-shadow);\n  backdrop-filter: blur(12px);\n  overflow: hidden;\n  z-index: 60;\n  transform-origin: top right;\n  animation: dropdownIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n@keyframes dropdownIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95) translateY(-10px);\n  }\n\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n.dropdown-header {\n  padding: 1rem 1.25rem;\n  background-color: rgba(0, 0, 0, 0.02);\n  border-bottom: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.dropdown-header .name {\n  font-size: 0.875rem;\n  font-weight: 700;\n  color: #111827;\n}\n\n.dropdown-header .role {\n  font-size: 0.75rem;\n  font-weight: 500;\n  color: #6b7280;\n  text-transform: capitalize;\n  margin-top: 2px;\n}\n\n.dropdown-menu {\n  padding: 0.5rem;\n}\n\n.dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.625rem 0.75rem;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: #374151;\n  text-decoration: none;\n  border-radius: 8px;\n  transition: transform 0.15s ease;\n  transform-origin: left center;\n}\n\n.dropdown-item:hover {\n  font-weight: 700;\n  transform: scale(1.03);\n  background-color: transparent;\n}\n\n.dropdown-item.logout {\n  color: #dc2626;\n  margin-top: 0.25rem;\n  border-top: 1px solid rgba(0, 0, 0, 0.05);\n  border-radius: 0 0 8px 8px;\n}\n\n.dropdown-item.logout:hover {\n  color: #dc2626;\n}\n\n/* Responsiveness */\n@media (max-width: 1024px) {\n  .navbar {\n    left: 0;\n    padding: 0 1.25rem;\n  }\n}\n\n@media (max-width: 768px) {\n  .navbar {\n    height: 64px;\n  }\n\n  .navbar-logo h2 {\n    font-size: 1.125rem;\n    max-width: 180px;\n  }\n\n  .nav-link.desktop-only {\n    display: none;\n  }\n\n  .user-name {\n    display: none;\n  }\n}\n\n@media (max-width: 480px) {\n  .navbar-logo h2 {\n    display: none;\n  }\n\n  .navbar-dropdown {\n    width: calc(100vw - 2rem);\n    right: -1rem;\n  }\n}\n"],"sourceRoot":""}]);
