;IAAA,kBAsEC;IAtED;EAsEC;;EAtED;IAAA,sBAsEC;IAtED,8BAsEC;IAtED;EAsEC;AAAA","sourcesContent":["@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');\n\n@layer base {\n  * {\n    @apply box-border;\n  }\n\n  html {\n    @apply scroll-smooth;\n    font-size: 13px;\n  }\n\n  /* Mobile-first responsive base font size */\n  @media (max-width: 640px) {\n    html {\n      font-size: 11px;\n    }\n  }\n\n  @media (min-width: 641px) and (max-width: 1024px) {\n    html {\n      font-size: 12px;\n    }\n  }\n\n  @media (min-width: 1025px) {\n    html {\n      font-size: 13px;\n    }\n  }\n\n  body {\n    @apply font-sans bg-gray-100 text-gray-900 antialiased;\n    font-family: \"Poppins\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    font-size: 0.8125rem; /* 13px base */\n  }\n\n  /* Responsive typography */\n  @media (max-width: 640px) {\n    body {\n      font-size: 0.6875rem; /* 11px on mobile */\n    }\n  }\n}\n\n@layer utilities {\n  /* Custom Scrollbar */\n  .scrollbar-thin::-webkit-scrollbar {\n    @apply w-2 h-2;\n  }\n\n  .scrollbar-thin::-webkit-scrollbar-track {\n    @apply bg-gray-200;\n  }\n\n  .scrollbar-thin::-webkit-scrollbar-thumb {\n    @apply bg-teal-500 rounded;\n  }\n\n  .scrollbar-thin::-webkit-scrollbar-thumb:hover {\n    @apply bg-teal-600;\n  }\n}\n\n::selection {\n  @apply bg-teal-500 text-white;\n}"],"sourceRoot":""}]);
