  const payeDeduction = (_deductionComponents$2 = deductionComponents.manualPaye) !== null && _deductionComponents$2 !== void 0 ? _deductionComponents$2 : calculatePaye(grossSalary);
  const nhimaDeduction = (_deductionComponents$3 = deductionComponents.manualNhima) !== null && _deductionComponents$3 !== void 0 ? _deductionComponents$3 : calculateNhima(salaryComponents.baseSalary);

  // Calculate non-statutory deductions
  const nonStatutoryDeductions = calculateNonStatutoryDeductions(deductionComponents);

  // Total deductions
  const totalDeductions = napsaDeduction + payeDeduction + nhimaDeduction + nonStatutoryDeductions;

  // Calculate net salary
  const netSalary = Math.max(0, grossSalary - totalDeductions);

  // Leave days remaining
  const leaveDaysRemaining = Math.max(0, leaveDaysEntitled - leaveDaysTaken);
  return {
    // Earnings
    baseSalary: salaryComponents.baseSalary,
    housingAllowance: salaryComponents.housingAllowance,
    transportAllowance: salaryComponents.transportAllowance,
    responsibilityAllowance: salaryComponents.responsibilityAllowance,
    otherAllowances: salaryComponents.otherAllowances,
    grossSalary,
    // Deductions
    daysAbsentDeduction: deductionComponents.daysAbsentDeduction,
    advanceSalaryRepayment: deductionComponents.advanceSalaryRepayment,
    loanRepayment: deductionComponents.loanRepayment,
    napsaDeduction,
    payeDeduction,
    nhimaDeduction,
    personalLevy: deductionComponents.personalLevy,
    rentDeduction: deductionComponents.rentDeduction,
    schoolFeesDeduction: deductionComponents.schoolFeesDeduction,
    otherDeductions: deductionComponents.otherDeductions,
    totalDeductions,
    // Net
    netSalary,
    // Tax breakdown
    taxBreakdown: {
      napsa: napsaDeduction,
      paye: payeDeduction,
      nhima: nhimaDeduction,
      personalLevy: deductionComponents.personalLevy,
      totalStatutory: napsaDeduction + payeDeduction + nhimaDeduction + deductionComponents.personalLevy
    },
    // Leave info
    leaveDaysTaken,
    leaveDaysRemaining
  };
}

/**
 * Calculate daily rate for absent days deduction
 */
function calculateDailyRate(monthlySalary, workingDays = 22) {
  return monthlySalary / workingDays;
}

/**
 * Calculate deduction for absent days
 */
function calculateAbsentDaysDeduction(monthlySalary, absentDays, workingDays = 22) {
  const dailyRate = calculateDailyRate(monthlySalary, workingDays);
  return dailyRate * absentDays;
}

/**
 * Format currency for display
 */
function formatCurrency(amount) {
  return new Intl.NumberFormat('en-ZM', {
    style: 'currency',
    currency: 'ZMW',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }).format(amount);
}

/**
 * Format number with thousands separator
 */
function formatNumber(num) {
  return new Intl.NumberFormat('en-US').format(num);
}

/**
 * Parse currency string to number
 */
function parseCurrency(value) {
  const cleaned = value.replace(/[^0-9.-]/g, '');
  return parseFloat(cleaned) || 0;
}

/**
 * Validate salary input
 */
function validateSalary(amount) {
  if (amount < 0) {
    return {
      valid: false,
      message: 'Salary cannot be negative'
    };
  }
  if (amount > 1000000) {
    return {
      valid: false,
      message: 'Salary amount seems unrealistic'
    };
  }
  return {
    valid: true
  };
}

/**
 * Generate payroll period name from date
 */
function generatePeriodName(date) {
  const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  return `${monthNames[date.getMonth()]} ${date.getFullYear()}`;
}

/**
 * Calculate employer NAPSA contribution
 */
function calculateEmployerNapsa(grossSalary) {
  const taxableAmount = Math.min(grossSalary, NAPSA_CONFIG.monthlyCeiling);
  return taxableAmount * NAPSA_CONFIG.employerRate;
}

/**
 * Get PAYE breakdown for display
 */
function getPayeBreakdown(grossSalary) {
  const breakdown = [];
  let remainingIncome = grossSalary;
  const bracketLabels = ['ZMW 0 - ZMW 5,100', 'ZMW 5,101 - ZMW 7,100', 'ZMW 7,101 - ZMW 9,200', 'Above ZMW 9,200'];
  for (let i = 0; i < PAYE_BRACKETS.length; i++) {
    if (remainingIncome <= PAYE_BRACKETS[i].min) break;
    const bracket = PAYE_BRACKETS[i];
    const taxableInBracket = Math.min(remainingIncome - bracket.min, bracket.max - bracket.min);
    if (taxableInBracket > 0) {
      breakdown.push({
        bracket: bracketLabels[i],
        amount: taxableInBracket * bracket.rate,
        rate: bracket.rate * 100
      });
    }
  }
  return breakdown;
}

/**
 * Create empty salary components
 */
function getEmptySalaryComponents() {
  return {
    baseSalary: 0,
    housingAllowance: 0,
    transportAllowance: 0,
    responsibilityAllowance: 0,
    otherAllowances: 0
  };
}

/**
 * Create empty deduction components
 */
function getEmptyDeductionComponents() {
  return {
    daysAbsentDeduction: 0,
    advanceSalaryRepayment: 0,
    loanRepayment: 0,
    rentDeduction: 0,
    schoolFeesDeduction: 0,
    personalLevy: 0,
    otherDeductions: 0
  };
}

/**
 * Calculate total cost to employer
 */
function calculateEmployerCost(grossSalary) {
  const employerNapsa = calculateEmployerNapsa(grossSalary);
  return {
    grossSalary,
    employerNapsa,
    totalEmployerCost: grossSalary + employerNapsa
  };
}

