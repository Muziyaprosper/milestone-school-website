// Module
___CSS_LOADER_EXPORT___.push([module.id, `/* Student Performance Modal Styles */
.spm-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 20px;
    overflow-y: auto;
    animation: fadeIn 0.2s ease-out;
}

.spm-modal-content {
    background-color: #ffffff;
    width: 100%;
    max-width: 72rem; /* 1152px - max-w-6xl */
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    animation: slideUp 0.3s ease-out;
    position: relative;
    max-height: calc(90vh - 40px);
    overflow-y: auto;
    margin: auto;
}

.spm-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
}

.spm-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    line-height: 1.3;
}

.spm-sub {
    font-size: 0.75rem;
    color: #64748b;
    margin: 2px 0 0 0;
    line-height: 1.4;
}

.spm-close-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: none;
    background-color: #f8fafc;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    margin-left: 16px;
}

.spm-close-btn:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    transform: rotate(90deg);
}

.close-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: none;
    background-color: #f8fafc;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    margin-left: 16px;
}

.close-btn:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    transform: rotate(90deg);
}

.spm-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 2px solid #f1f5f9;
}

.spm-tab {
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: -2px;
}

.spm-tab:hover {
    color: #0f172a;
    background-color: #f8fafc;
}

.spm-tab.active {
    color: #0d9488;
    border-bottom-color: #0d9488;
}

.spm-tab-button {
    padding: 12px 20px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    margin-bottom: -2px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.spm-tab-button:hover {
    color: #0f172a;
    background-color: #f8fafc;
}

.spm-tab-button.active {
    color: #0d9488;
    border-bottom-color: #0d9488;
}

.spm-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.spm-stat-card {
    padding: 16px;
    border-radius: 10px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
}

.spm-stat-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.spm-stat-value {
    font-size: 1.875rem;
    font-weight: 700;
    color: #0f172a;
}

.spm-attendance-section,
.spm-results-section {
    margin-top: 24px;
}

.spm-loading,
.spm-empty {
    text-align: center;
    padding: 40px;
    color: #94a3b8;
    font-size: 0.875rem;
}

.spm-table-wrap {
    overflow-x: auto;
    margin-top: 16px;
}

.spm-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 8px;
}

.spm-table th {
    text-align: left;
    padding: 12px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background-color: #f8fafc;
}

.spm-table td {
    padding: 12px 16px;
    background-color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 500;
    border-top: 1px solid #f8fafc;
    border-bottom: 1px solid #f8fafc;
}

.spm-table tr td:first-child {
    border-left: 1px solid #f8fafc;
    border-radius: 12px 0 0 12px;
}

.spm-table tr td:last-child {
    border-right: 1px solid #f8fafc;
    border-radius: 0 12px 12px 0;
}

.spm-table tr:hover td {
    background-color: #f8fafc;
}

.spm-score-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
}

.spm-score-badge[data-score] {
    background-color: #f0fdf4;
    color: #16a34a;
}

.spm-score-badge[data-score="90"],
.spm-score-badge[data-score="91"],
.spm-score-badge[data-score="92"],
.spm-score-badge[data-score="93"],
.spm-score-badge[data-score="94"],
.spm-score-badge[data-score="95"],
.spm-score-badge[data-score="96"],
.spm-score-badge[data-score="97"],
.spm-score-badge[data-score="98"],
.spm-score-badge[data-score="99"],
.spm-score-badge[data-score="100"] {
    background-color: #f0fdf4;
    color: #16a34a;
}

@media (max-width: 768px) {
    .spm-modal-overlay {
        padding: 12px;
    }
    
    .spm-modal-content {
        padding: 24px;
        border-radius: 16px;
        max-height: calc(95vh - 24px);
    }
    
    .spm-title {
        font-size: 1.25rem;
    }
}

@media (max-width: 640px) {
    .spm-modal-overlay {
        padding: 8px;
    }
    
    .spm-modal-content {
        padding: 20px;
        border-radius: 12px;
        max-height: calc(95vh - 16px);
    }
    
    .spm-title {
        font-size: 1.125rem;
    }
    
    .spm-tabs {
        flex-wrap: wrap;
    }
    
    .spm-tab {
        padding: 8px 12px;
        font-size: 0.75rem;
    }
}
