___CSS_LOADER_EXPORT___.push([module.id, `/* Main Wrapper - Student Portal Premium Design */

/* Sidebar width variable - must match sidebar.css and Navbar.css */
:root {
  --sidebar-width: 240px;
  --sidebar-width-mobile: 200px;
  --navbar-height: 70px;
}

.main-wrapper {
  background-color: #ffffff;
  min-height: 100vh;
  transition: all 0.3s ease;
  margin-left: var(--sidebar-width);
  margin-top: 5rem;
  padding-left: 2rem;
  padding-right: 2rem;
  padding-bottom: 2rem;
  width: calc(100% - var(--sidebar-width));
  overflow-x: hidden;
}

.main-wrapper.shifted {
  padding-top: 3rem;
  padding: 2rem;
  width: calc(100% - var(--sidebar-width));
}

.main-wrapper.collapsed {
  margin-left: 0;
  padding-top: var(--navbar-height);
  padding-left: 2rem;
  padding-right: 2rem;
  padding-bottom: 2rem;
  width: 100%;
}

.main-wrapper.full-top {
  margin: 0;
  padding: 2rem;
  padding-top: 2rem;
  width: 100%;
}

@media (max-width: 1024px) {
  .main-wrapper {
    margin-left: var(--sidebar-width-mobile);
    padding-left: calc(var(--sidebar-width-mobile) + 2rem);
    width: calc(100% - var(--sidebar-width-mobile));
  }

  .main-wrapper.shifted {
    margin-left: var(--sidebar-width-mobile);
    padding-left: calc(var(--sidebar-width-mobile) + 2rem);
    width: calc(100% - var(--sidebar-width-mobile));
  }
}

@media (max-width: 768px) {
  .main-wrapper {
    margin-left: 0;
    padding-top: 70px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
    width: 100% !important;
  }

  .main-wrapper.shifted {
    margin-left: 0;
    padding-top: 70px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
    width: 100% !important;
  }

  .main-wrapper.collapsed {
    margin-left: 0;
    padding-top: 70px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 1.5rem;
    width: 100% !important;
  }

  .main-wrapper.full-top {
    padding-top: 1.5rem;
  }
}
`, "",{"version":3,"sources":["webpack://./src/styles/App.css"],"names":[],"mappings":"AAAA,iDAAiD;;AAEjD,mEAAmE;AACnE;EACE,sBAAsB;EACtB,6BAA6B;EAC7B,qBAAqB;AACvB;;AAEA;EACE,yBAAyB;EACzB,iBAAiB;EACjB,yBAAyB;EACzB,iCAAiC;EACjC,gBAAgB;EAChB,kBAAkB;EAClB,mBAAmB;EACnB,oBAAoB;EACpB,wCAAwC;EACxC,kBAAkB;AACpB;;AAEA;EACE,iBAAiB;EACjB,aAAa;EACb,wCAAwC;AAC1C;;AAEA;EACE,cAAc;EACd,iCAAiC;EACjC,kBAAkB;EAClB,mBAAmB;EACnB,oBAAoB;EACpB,WAAW;AACb;;AAEA;EACE,SAAS;EACT,aAAa;EACb,iBAAiB;EACjB,WAAW;AACb;;AAEA;EACE;IACE,wCAAwC;IACxC,sDAAsD;IACtD,+CAA+C;EACjD;;EAEA;IACE,wCAAwC;IACxC,sDAAsD;IACtD,+CAA+C;EACjD;AACF;;AAEA;EACE;IACE,cAAc;IACd,iBAAiB;IACjB,oBAAoB;IACpB,qBAAqB;IACrB,sBAAsB;IACtB,sBAAsB;EACxB;;EAEA;IACE,cAAc;IACd,iBAAiB;IACjB,oBAAoB;IACpB,qBAAqB;IACrB,sBAAsB;IACtB,sBAAsB;EACxB;;EAEA;IACE,cAAc;IACd,iBAAiB;IACjB,oBAAoB;IACpB,qBAAqB;IACrB,sBAAsB;IACtB,sBAAsB;EACxB;;EAEA;IACE,mBAAmB;EACrB;AACF","sourcesContent":["/* Main Wrapper - Student Portal Premium Design */\n\n/* Sidebar width variable - must match sidebar.css and Navbar.css */\n:root {\n  --sidebar-width: 240px;\n  --sidebar-width-mobile: 200px;\n  --navbar-height: 70px;\n}\n\n.main-wrapper {\n  background-color: #ffffff;\n  min-height: 100vh;\n  transition: all 0.3s ease;\n  margin-left: var(--sidebar-width);\n  margin-top: 5rem;\n  padding-left: 2rem;\n  padding-right: 2rem;\n  padding-bottom: 2rem;\n  width: calc(100% - var(--sidebar-width));\n  overflow-x: hidden;\n}\n\n.main-wrapper.shifted {\n  padding-top: 3rem;\n  padding: 2rem;\n  width: calc(100% - var(--sidebar-width));\n}\n\n.main-wrapper.collapsed {\n  margin-left: 0;\n  padding-top: var(--navbar-height);\n  padding-left: 2rem;\n  padding-right: 2rem;\n  padding-bottom: 2rem;\n  width: 100%;\n}\n\n.main-wrapper.full-top {\n  margin: 0;\n  padding: 2rem;\n  padding-top: 2rem;\n  width: 100%;\n}\n\n@media (max-width: 1024px) {\n  .main-wrapper {\n    margin-left: var(--sidebar-width-mobile);\n    padding-left: calc(var(--sidebar-width-mobile) + 2rem);\n    width: calc(100% - var(--sidebar-width-mobile));\n  }\n\n  .main-wrapper.shifted {\n    margin-left: var(--sidebar-width-mobile);\n    padding-left: calc(var(--sidebar-width-mobile) + 2rem);\n    width: calc(100% - var(--sidebar-width-mobile));\n  }\n}\n\n@media (max-width: 768px) {\n  .main-wrapper {\n    margin-left: 0;\n    padding-top: 70px;\n    padding-left: 1.5rem;\n    padding-right: 1.5rem;\n    padding-bottom: 1.5rem;\n    width: 100% !important;\n  }\n\n  .main-wrapper.shifted {\n    margin-left: 0;\n    padding-top: 70px;\n    padding-left: 1.5rem;\n    padding-right: 1.5rem;\n    padding-bottom: 1.5rem;\n    width: 100% !important;\n  }\n\n  .main-wrapper.collapsed {\n    margin-left: 0;\n    padding-top: 70px;\n    padding-left: 1.5rem;\n    padding-right: 1.5rem;\n    padding-bottom: 1.5rem;\n    width: 100% !important;\n  }\n\n  .main-wrapper.full-top {\n    padding-top: 1.5rem;\n  }\n}\n"],"sourceRoot":""}]);
