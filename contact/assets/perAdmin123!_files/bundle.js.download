AAEA;EACE,4BAA4B;EAC5B,gBAAgB;AAClB;;AAEA;EACE,WAAW;EACX,iBAAiB;EACjB,4BAA4B;EAC5B,eAAe;AACjB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,oBAAoB;EACpB,mBAAmB;EACnB,cAAc;EACd,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB;;AAEA;EACE,SAAO;EACP,YAAY;AACd;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,SAAS;AACX;;AAEA;EACE,UAAU;EACV,WAAW;EACX,oBAAoB;EACpB,8BAA8B;AAChC;;AAEA,8CAA8C;AAC9C;EACE,aAAa;EACb,sBAAsB;EACtB,YAAY;EACZ,gBAAgB;AAClB;;AAEA;EACE,kBAAkB;EAClB,0CAA0C;EAC1C,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,oBAAoB;EACpB,YAAY;EACZ,mBAAmB;EACnB,eAAe;EACf,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,2BAA2B;AAC7B;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,SAAS;EACT,SAAO;AACT;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,oBAAoB;EACpB,mBAAmB;EACnB,cAAc;EACd,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB;;AAEA;EACE,aAAa;EACb,sBAAsB;EACtB,QAAQ;AACV;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,2BAA2B;AAC7B;;AAEA;EACE,eAAe;EACf,4BAA4B;AAC9B;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,uBAAuB;EACvB,gBAAgB;AAClB;;AAEA;EACE,cAAc;EACd,kBAAkB;EAClB,kBAAkB;EAClB,mBAAmB;EACnB,eAAe;EACf,gBAAgB;EAChB,qBAAqB;EACrB,qBAAqB;EACrB,kBAAkB;EAClB,oBAAoB;AACtB;;AAEA;EACE,aAAa;EACb,SAAS;EACT,mBAAmB;EACnB,qBAAqB;AACvB;;AAEA;EACE,yBAAyB;AAC3B;;AAEA;EACE,2BAA2B;AAC7B;;AAEA;EACE,6DAA6D;EAC7D,WAAW;EACX,+BAA+B;AACjC;;AAEA;EACE,mBAAmB;EACnB,cAAc;EACd,8BAA8B;AAChC;;AAEA;EACE,eAAe;EACf,4BAA4B;EAC5B,eAAe;EACf,aAAa;EACb,mBAAmB;EACnB,QAAQ;AACV;;AAEA;EACE,oBAAoB;EACpB,mBAAmB;AACrB;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,oBAAoB;EACpB,mBAAmB;EACnB,cAAc;EACd,gBAAgB;EAChB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,eAAe;AACjB;;AAEA;EACE,uCAAuC;EACvC,kBAAkB;EAClB,aAAa;EACb,SAAS;EACT,mBAAmB;EACnB,gBAAgB;AAClB;;AAEA;EACE,SAAO;EACP,gBAAgB;EAChB,iBAAiB;EACjB,yBAAyB;EACzB,oBAAoB;EACpB,kBAAkB;EAClB,eAAe;EACf,oBAAoB;EACpB,gBAAgB;EAChB,mBAAmB;AACrB;;AAEA;EACE,aAAa;EACb,mBAAmB;EACnB,QAAQ;EACR,kBAAkB;EAClB,8BAA8B;EAC9B,WAAW;EACX,YAAY;EACZ,oBAAoB;EACpB,gBAAgB;EAChB,eAAe;AACjB;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA;EACE,eAAe;EACf,cAAc;AAChB;;AAEA,qDAAqD;AACrD;EACE,eAAe;EACf,SAAS;EACT,WAAW;EACX,YAAY;EACZ,gBAAgB;EAChB,4BAA4B;EAC5B,qHAAqH;EACrH,uBAAuB;EACvB,aAAa;EACb,sBAAsB;EACtB,yBAAyB;AAC3B;;AAEA;EACE,YAAY;EACZ,gBAAgB;AAClB;;AAEA;EACE,mBAAmB;EACnB,WAAW;EACX,YAAY;EACZ,eAAe;EACf,aAAa;EACb,mBAAmB;EACnB,8BAA8B;EAC9B,4BAA4B;EAC5B,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,gBAAgB;AAClB;;AAEA;EACE,aAAa;EACb,QAAQ;AACV;;AAEA;EACE,uBAAuB;EACvB,YAAY;EACZ,WAAW;EACX,eAAe;EACf,YAAY;EACZ,aAAa;EACb,mBAAmB;EACnB,YAAY;AACd;;AAEA;EACE,UAAU;EACV,oCAAoC;EACpC,kBAAkB;AACpB;;AAEA;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;AACxB;;AAEA;EACE,iBAAiB;EACjB,mBAAmB;EACnB,cAAc;EACd,eAAe;EACf,gCAAgC;AAClC;;AAEA;EACE,iBAAiB;EACjB,gCAAgC;EAChC,aAAa;EACb,mBAAmB;EACnB,SAAS;AACX;;AAEA;EACE,eAAe;EACf,cAAc;EACd,WAAW;AACb;;AAEA;;EAEE,SAAO;EACP,YAAY;EACZ,aAAa;EACb,eAAe;EACf,cAAc;AAChB;;AAEA;EACE,SAAO;EACP,aAAa;AACf;;AAEA;EACE,WAAW;EACX,aAAa;EACb,YAAY;EACZ,aAAa;EACb,gBAAgB;EAChB,eAAe;EACf,gBAAgB;EAChB,oBAAoB;AACtB;;AAEA;EACE,kBAAkB;EAClB,6BAA6B;EAC7B,aAAa;EACb,2BAA2B;AAC7B;;AAEA;EACE,8BAA8B;EAC9B,WAAW;EACX,YAAY;EACZ,iBAAiB;EACjB,oBAAoB;EACpB,gBAAgB;EAChB,eAAe;EACf,2BAA2B;AAC7B;;AAEA;EACE,mBAAmB;AACrB;;AAEA;EACE,YAAY;EACZ,mBAAmB;AACrB;;AAEA,iBAAiB;AACjB;EACE,SAAO;EACP,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,uBAAuB;EACvB,4BAA4B;EAC5B,SAAS;AACX;;AAEA;EACE,kBAAkB;AACpB;;AAEA;EACE,eAAe;EACf,gBAAgB;EAChB,2BAA2B;EAC3B,eAAe;AACjB;;AAEA;EACE,eAAe;EACf,4BAA4B;EAC5B,SAAS;AACX;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,gBAAgB;EAChB,kBAAkB;EAClB,aAAa;EACb,mBAAmB;EACnB,uBAAuB;EACvB,mBAAmB;EACnB,cAAc;EACd,gDAAgD;AAClD;;AAEA;EACE,gBAAgB;EAChB,oBAAoB;EACpB,mBAAmB;EACnB,QAAQ;EACR,iBAAiB;EACjB,mBAAmB;EACnB,yBAAyB;EACzB,oBAAoB;EACpB,eAAe;EACf,cAAc;EACd,gBAAgB;AAClB;;AAEA;EACE,kCAAkC;AACpC;;AAEA;EACE,WAAW;EACX,YAAY;EACZ,kBAAkB;EAClB,yBAAyB;EACzB,yBAAyB;EACzB,oCAAoC;EACpC,8CAA8C;AAChD;;AAEA;EACE;IACE,uBAAuB;EACzB;;EAEA;IACE,yBAAyB;EAC3B;AACF;;AAEA;EACE;IACE,aAAa;EACf;;EAEA;IACE,WAAW;IACX,QAAQ;IACR,SAAS;IACT,gBAAgB;EAClB;;EAEA;IACE,eAAe;EACjB;;EAEA;IACE,kBAAkB;EACpB;;EAEA;IACE,cAAc;EAChB;;EAEA;IACE,kBAAkB;EACpB;AACF;;AAEA;EACE,kBAAkB;EAClB,YAAY;EACZ,aAAa;EACb,sBAAsB;AACxB;;AAEA;EACE,YAAY;EACZ,sCAAsC;EACtC,kBAAkB;EAClB,aAAa;EACb,sBAAsB;EACtB,mBAAmB;EACnB,uBAAuB;EACvB,SAAS;EACT,cAAc;EACd,wBAAwB;AAC1B;;AAEA;EACE,YAAY;EACZ,aAAa;EACb,mBAAmB;EACnB,uBAAuB;AACzB","sourcesContent":["/* Enterprise Messaging & Communication System */\n:root {\n  --msg-primary: #0084ff;\n  --msg-accent: #00b2ff;\n  --msg-hover: #f0f2f5;\n  --msg-active: #e7f3ff;\n  --msg-border: #e5e7eb;\n  --msg-text-main: #050505;\n  --msg-text-muted: #65676b;\n  --msg-sidebar-w: 320px;\n  --z-modal: 2000;\n}\n\n.messages-layout-new {\n  display: flex;\n  height: calc(100vh - 84px);\n  background: #f0f2f5;\n  font-family: 'Manrope', 'Helvetica Neue', 'Segoe UI', sans-serif;\n  overflow: hidden;\n}\n\n/* Sidebar Styling */\n.sidebar-container {\n  width: var(--msg-sidebar-w);\n  min-width: var(--msg-sidebar-w);\n  padding: 8px 0;\n  background: #fff;\n  display: flex;\n  flex-direction: column;\n  border-right: 1px solid var(--msg-border);\n}\n\n.sidebar-top {\n  padding: 8px 16px 16px;\n}\n\n.sidebar-compose-btn {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 24px;\n  background: var(--msg-primary);\n  border: none;\n  border-radius: 999px;\n  box-shadow: 0 12px 24px rgba(0, 132, 255, 0.25);\n  font-weight: 600;\n  font-size: 14px;\n  color: #fff;\n  cursor: pointer;\n  transition: box-shadow 0.2s;\n}\n\n.sidebar-compose-btn:hover {\n  box-shadow: 0 16px 28px rgba(0, 132, 255, 0.3);\n  background: #0a7cff;\n}\n\n.nav-link {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 8px 24px;\n  border: none;\n  background: transparent;\n  color: var(--msg-text-main);\n  border-radius: 999px;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 500;\n  text-align: left;\n  margin: 4px 12px;\n}\n\n.nav-link:hover {\n  background: var(--msg-hover);\n}\n\n.nav-link.active {\n  background: var(--msg-active);\n  color: #0a7cff;\n  font-weight: 700;\n}\n\n/* Main Viewport */\n.main-viewport {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  border-left: none;\n  position: relative;\n}\n\n.main-header {\n  height: 64px;\n  padding: 0 20px;\n  display: flex;\n  align-items: center;\n  border-bottom: 1px solid var(--msg-border);\n  background: #fff;\n}\n\n.header-actions-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-left: 12px;\n}\n\n.nav-badge {\n  margin-left: auto;\n  background: var(--msg-primary);\n  color: #fff;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 999px;\n}\n\n.icon-btn {\n  width: 36px;\n  height: 36px;\n  border-radius: 999px;\n  border: none;\n  background: #f0f2f5;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #0f172a;\n}\n\n.icon-btn:hover {\n  background: #e4e6eb;\n}\n\n.search-box-container {\n  flex: 1;\n  max-width: 720px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #f0f2f5;\n  padding: 10px 16px;\n  border-radius: 999px;\n  margin-left: 0;\n}\n\n.search-box-container input {\n  flex: 1;\n  background: transparent;\n  border: none;\n  outline: none;\n  font-size: 14px;\n}\n\n/* Thread List View */\n.content-overflow-area {\n  flex: 1;\n  overflow-y: auto;\n  background: #fff;\n}\n\n.list-item {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 12px 20px;\n  border-bottom: 1px solid #f3f4f6;\n  cursor: pointer;\n  font-size: 14px;\n  transition: background 0.1s;\n}\n\n.list-item:hover {\n  background: #f0f2f5;\n  box-shadow: inset 0 -1px 0 #e5e7eb;\n}\n\n.list-item.is-unread {\n  background: #f5faff;\n  font-weight: 700;\n}\n\n.item-sender {\n  max-width: 200px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-weight: 600;\n}\n\n.item-snippet {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  display: flex;\n  gap: 8px;\n  color: var(--msg-text-muted);\n}\n\n.item-snippet .subject {\n  color: var(--msg-text-main);\n  font-weight: 600;\n}\n\n.item-snippet .dash {\n  color: #5f6368;\n  margin: 0 4px;\n}\n\n.item-snippet .preview {\n  color: var(--msg-text-muted);\n  font-weight: 400;\n}\n\n.item-date {\n  width: 80px;\n  text-align: right;\n  color: var(--msg-text-muted);\n  font-size: 12px;\n}\n\n.item-avatar {\n  width: 40px;\n  height: 40px;\n  border-radius: 999px;\n  background: #dbeafe;\n  color: #0a7cff;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.item-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.item-top-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.unread-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: var(--msg-primary);\n}\n\n/* --- Full Thread View (Document Style) --- */\n.thread-container-full {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  background: #fff;\n}\n\n.thread-header-fixed {\n  padding: 12px 20px;\n  border-bottom: 1px solid var(--msg-border);\n  background: #fff;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n\n.icon-btn-back {\n  width: 40px;\n  height: 40px;\n  border-radius: 999px;\n  border: none;\n  background: #f0f2f5;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--msg-text-main);\n}\n\n.icon-btn-back:hover {\n  background: #e4e6eb;\n}\n\n.thread-header-title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex: 1;\n}\n\n.thread-header-title .avatar {\n  width: 44px;\n  height: 44px;\n  border-radius: 999px;\n  background: #dbeafe;\n  color: #0a7cff;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.thread-header-title .details {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.thread-header-title .details .name {\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--msg-text-main);\n}\n\n.thread-header-title .details .subject {\n  font-size: 13px;\n  color: var(--msg-text-muted);\n}\n\n.thread-content-full {\n  flex: 1;\n  overflow-y: auto;\n  padding: 20px 20px 12px;\n  background: #fff;\n}\n\n.chat-bubble {\n  max-width: 70%;\n  width: fit-content;\n  padding: 12px 14px;\n  border-radius: 18px;\n  font-size: 14px;\n  line-height: 1.5;\n  white-space: pre-wrap;\n  word-wrap: break-word;\n  position: relative;\n  display: inline-flex;\n}\n\n.chat-row {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 16px;\n  align-items: flex-end;\n}\n\n.chat-row.sent {\n  justify-content: flex-end;\n}\n\n.chat-row.received {\n  justify-content: flex-start;\n}\n\n.chat-row.sent .chat-bubble {\n  background: linear-gradient(180deg, #0084ff 0%, #0073ff 100%);\n  color: #fff;\n  border-bottom-right-radius: 6px;\n}\n\n.chat-row.received .chat-bubble {\n  background: #e4e6eb;\n  color: #050505;\n  border-bottom-left-radius: 6px;\n}\n\n.chat-meta {\n  font-size: 11px;\n  color: var(--msg-text-muted);\n  margin-top: 6px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.chat-meta .status {\n  display: inline-flex;\n  align-items: center;\n}\n\n.chat-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 999px;\n  background: #dbeafe;\n  color: #0a7cff;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n}\n\n.chat-composer {\n  border-top: 1px solid var(--msg-border);\n  padding: 12px 20px;\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  background: #fff;\n}\n\n.chat-composer textarea {\n  flex: 1;\n  min-height: 42px;\n  max-height: 120px;\n  border: 1px solid #e5e7eb;\n  border-radius: 999px;\n  padding: 10px 12px;\n  font-size: 14px;\n  font-family: inherit;\n  resize: vertical;\n  background: #f0f2f5;\n}\n\n.chat-composer .send-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 10px 16px;\n  background: var(--msg-primary);\n  color: #fff;\n  border: none;\n  border-radius: 999px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.chat-composer .send-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.composer-error {\n  font-size: 12px;\n  color: #b91c1c;\n}\n\n/* --- Compose & Reply Modals (Universal Style) --- */\n.compose-modal {\n  position: fixed;\n  bottom: 0;\n  right: 80px;\n  width: 550px;\n  background: #fff;\n  border-radius: 12px 12px 0 0;\n  box-shadow: 0 8px 10px 1px rgba(0, 0, 0, 0.14), 0 3px 14px 2px rgba(0, 0, 0, 0.12), 0 5px 5px -3px rgba(0, 0, 0, 0.2);\n  z-index: var(--z-modal);\n  display: flex;\n  flex-direction: column;\n  border: 1px solid #dadce0;\n}\n\n.compose-modal.minimized {\n  height: 40px;\n  overflow: hidden;\n}\n\n.modal-header {\n  background: #1877f2;\n  color: #fff;\n  height: 40px;\n  padding: 0 16px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-radius: 12px 12px 0 0;\n  cursor: pointer;\n}\n\n.modal-header span {\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.header-actions button {\n  background: transparent;\n  border: none;\n  color: #fff;\n  cursor: pointer;\n  padding: 4px;\n  display: flex;\n  align-items: center;\n  opacity: 0.8;\n}\n\n.header-actions button:hover {\n  opacity: 1;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 2px;\n}\n\n.modal-body {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.modal-error {\n  padding: 8px 16px;\n  background: #fde8e8;\n  color: #c81e1e;\n  font-size: 13px;\n  border-bottom: 1px solid #fbd5d5;\n}\n\n.modal-field {\n  padding: 8px 16px;\n  border-bottom: 1px solid #f1f3f4;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.modal-field label {\n  font-size: 13px;\n  color: #5f6368;\n  width: 60px;\n}\n\n.modal-field input,\n.modal-field select {\n  flex: 1;\n  border: none;\n  outline: none;\n  font-size: 14px;\n  padding: 4px 0;\n}\n\n.modal-text-area {\n  flex: 1;\n  padding: 16px;\n}\n\n.modal-text-area textarea {\n  width: 100%;\n  height: 350px;\n  border: none;\n  outline: none;\n  resize: vertical;\n  font-size: 14px;\n  line-height: 1.5;\n  font-family: inherit;\n}\n\n.modal-footer {\n  padding: 12px 16px;\n  border-top: 1px solid #f1f3f4;\n  display: flex;\n  justify-content: flex-start;\n}\n\n.modal-send-btn {\n  background: var(--msg-primary);\n  color: #fff;\n  border: none;\n  padding: 8px 24px;\n  border-radius: 999px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.modal-send-btn:hover:not(:disabled) {\n  background: #174ea6;\n}\n\n.modal-send-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n/* Empty States */\n.messages-empty-state {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: var(--msg-text-muted);\n  gap: 16px;\n}\n\n.modern-hero {\n  text-align: center;\n}\n\n.modern-hero h2 {\n  font-size: 24px;\n  font-weight: 600;\n  color: var(--msg-text-main);\n  margin: 0 0 8px;\n}\n\n.modern-hero p {\n  font-size: 14px;\n  color: var(--msg-text-muted);\n  margin: 0;\n}\n\n.hero-icon-box {\n  width: 80px;\n  height: 80px;\n  background: #fff;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 24px;\n  color: #1877f2;\n  box-shadow: 0 10px 30px rgba(24, 119, 242, 0.16);\n}\n\n.unread-banner {\n  margin-top: 24px;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  background: #e7f3ff;\n  border: 1px solid #cfe2ff;\n  border-radius: 999px;\n  font-size: 13px;\n  color: #1877f2;\n  font-weight: 600;\n}\n\n.spin {\n  animation: spin 1s linear infinite;\n}\n\n.pro-loader {\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  border: 3px solid #e4e6eb;\n  border-top-color: #1877f2;\n  animation: spin 0.9s linear infinite;\n  box-shadow: 0 6px 14px rgba(24, 119, 242, 0.2);\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@media (max-width: 768px) {\n  .sidebar-container {\n    display: none;\n  }\n\n  .compose-modal {\n    width: 100%;\n    right: 0;\n    bottom: 0;\n    border-radius: 0;\n  }\n\n  .thread-title-section {\n    padding-left: 0;\n  }\n\n  .thread-content-full {\n    padding-left: 16px;\n  }\n\n  .chat-bubble {\n    max-width: 85%;\n  }\n\n  .thread-header-fixed {\n    padding: 10px 16px;\n  }\n}\n\n.thread-list-container {\n  position: relative;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n.thread-list-container .empty-state {\n  margin: auto;\n  /* Centers horizontally & vertically */\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  color: #6b7280;\n  /* Optional muted tone */\n}\n\n.thread-list-container .loading-state {\n  margin: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n"],"sourceRoot":""}]);
