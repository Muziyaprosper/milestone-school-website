// Module
___CSS_LOADER_EXPORT___.push([module.id, `.fees-page .fees-card {
  border: 1px solid #e2e8f0;
  background: linear-gradient(140deg, #ffffff 0%, #f8fafc 100%);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
}

.fees-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.fees-total-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: #ecfeff;
  border: 1px solid #cffafe;
  color: #0f766e;
  font-size: 12px;
  font-weight: 600;
}

.fees-items-head {
  display: none;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 11px;
  color: #64748b;
  padding: 0 2px;
}

.fees-item-row {
  padding: 12px;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.fees-item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.fees-line-total {
  font-size: 12px;
  font-weight: 600;
  color: #0f172a;
}

.fees-input-error {
  border-color: #f87171;
  box-shadow: 0 0 0 2px rgba(248, 113, 113, 0.12);
}

.fees-inline-error {
  font-size: 12px;
  color: #b91c1c;
}

.fees-fee-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
}

.fees-inline-form {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.fees-message {
  border-left: 4px solid #38bdf8;
}

.fees-helper {
  margin-top: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #475569;
  font-size: 13px;
}

@media (min-width: 768px) {
  .fees-items-head {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .fees-item-actions {
    justify-content: flex-end;
    gap: 16px;
  }
}

@media (max-width: 767px) {
  .fees-card-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
