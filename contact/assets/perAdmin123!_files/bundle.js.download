flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.fees-line-total {\n  font-size: 12px;\n  font-weight: 600;\n  color: #0f172a;\n}\n\n.fees-input-error {\n  border-color: #f87171;\n  box-shadow: 0 0 0 2px rgba(248, 113, 113, 0.12);\n}\n\n.fees-inline-error {\n  font-size: 12px;\n  color: #b91c1c;\n}\n\n.fees-fee-details {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  padding: 12px;\n  border-radius: 14px;\n  border: 1px solid #e2e8f0;\n  background: #f8fafc;\n}\n\n.fees-inline-form {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.fees-message {\n  border-left: 4px solid #38bdf8;\n}\n\n.fees-helper {\n  margin-top: 20px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 16px;\n  border-radius: 14px;\n  border: 1px solid #e2e8f0;\n  background: #f8fafc;\n  color: #475569;\n  font-size: 13px;\n}\n\n@media (min-width: 768px) {\n  .fees-items-head {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 12px;\n  }\n\n  .fees-item-actions {\n    justify-content: flex-end;\n    gap: 16px;\n  }\n}\n\n@media (max-width: 767px) {\n  .fees-card-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n"],"sourceRoot":""}]);
