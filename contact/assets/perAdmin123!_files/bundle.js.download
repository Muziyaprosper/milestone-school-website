___CSS_LOADER_EXPORT___.push([module.id, `/* Forgot Password - Modern Styling */

.forgot-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  background-color: #f9fafb;
}

.forgot-card {
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}

.forgot-card > div {
  width: 100%;
  max-width: 28rem;
  background-color: white;
  border-radius: 0.75rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  border: 1px solid #f3f4f6;
}

.forgot-card .top-bar {
  height: 0.5rem;
  width: 100%;
  background-color: #0d9488;
}

.forgot-card .content {
  padding: 2.5rem;
}

.forgot-card .logo-container {
  display: flex;
  justify-content: center;
  margin-bottom: 0.75rem;
}

.forgot-card .logo-container img {
  height: 4rem;
  width: auto;
  object-fit: contain;
}

.forgot-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: #1f2937;
  text-align: center;
  margin-bottom: 2rem;
}

.forgot-subtitle {
  font-size: 0.8125rem;
  color: #6b7280;
  text-align: center;
  margin-bottom: 1.5rem;
}

@media (max-width: 640px) {
  .forgot-card {
    padding: 1rem;
  }

  .forgot-card .content {
    padding: 1.5rem;
  }

  .forgot-card .logo-container img {
    height: 3rem;
  }

  .forgot-title {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .forgot-subtitle {
    font-size: 0.75rem;
    margin-bottom: 1.25rem;
  }
}

.forgot-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.forgot-input {
  width: 100%;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  border: 1px solid #d1d5db;
  font-size: 0.8125rem;
  transition: all 0.2s;
  outline: none;
}

@media (max-width: 640px) {
  .forgot-input {
    padding: 0.625rem 0.875rem;
    font-size: 0.75rem;
    border-radius: 0.375rem;
  }
}

.forgot-input:focus {
  border-color: transparent;
  box-shadow: 0 0 0 2px rgba(13, 148, 136, 0.2);
  border-color: #0d9488;
}

.forgot-role {
  display: flex;
  gap: 1.5rem;
  padding: 1rem;
  background-color: #f9fafb;
  border-radius: 0.5rem;
  border: 1px solid #e5e7eb;
}

.forgot-role label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: #374151;
  cursor: pointer;
  flex: 1 1;
  padding: 0.5rem;
  border-radius: 0.375rem;
  transition: all 0.2s;
}

.forgot-role label:hover {
  background-color: #f3f4f6;
}

.forgot-role input[type="radio"] {
  width: 1rem;
  height: 1rem;
  cursor: pointer;
  accent-color: #0d9488;
}

.forgot-button {
  width: 100%;
  background-color: #0d9488;
  color: white;
  font-weight: 700;
  padding: 0.75rem 1rem;
  border-radius: 9999px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.875rem;
}

@media (max-width: 640px) {
  .forgot-button {
    padding: 0.625rem 0.875rem;
    font-size: 0.75rem;
  }
}

.forgot-button:hover:not(:disabled) {
  background-color: #0f766e;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  transform: translateY(-2px);
}

.forgot-button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

.forgot-note {
  margin-top: 1rem;
  font-size: 0.75rem;
  color: #6b7280;
  text-align: center;
  font-style: italic;
}

.forgot-message {
  margin-top: 1rem;
  padding: 0.75rem;
  border-radius: 0.375rem;
  text-align: center;
  font-size: 0.875rem;
  font-weight: 500;
}

.forgot-message.success {
  background-color: #d1fae5;
  color: #065f46;
  border: 1px solid #a7f3d0;
}

.forgot-message.error {
  background-color: #fee2e2;
  color: #991b1b;
  border: 1px solid #fecaca;
}

.forgot-footer {
  margin-top: 2rem;
  text-align: center;
  font-size: 0.875rem;
  color: #6b7280;
}

.forgot-footer a {
  color: #0d9488;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s;
}

.forgot-footer a:hover {
  color: #0f766e;
  text-decoration: underline;
}

.forgot-divider {
  margin: 2rem 0;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.forgot-divider::before,
.forgot-divider::after {
  content: '';
  flex: 1 1;
  height: 1px;
  background-color: #d1d5db;
}

.forgot-divider span {
  font-size: 0.75rem;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

/* Loading spinner animation */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.animate-spin {
  animation: spin 1s linear infinite;
}
