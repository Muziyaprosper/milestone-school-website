___CSS_LOADER_EXPORT___.push([module.id, `/* Student Dashboard Styles */

.dashboard-section {
  margin-bottom: 2rem;
}

/* Quick links grid */
.dashboard-section .grid {
  display: grid;
  gap: 1rem;
}

.dashboard-section .grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

@media (max-width: 640px) {
  .dashboard-section .grid-cols-2 {
    grid-template-columns: 1fr;
  }
}

/* Card hover effects */
.dashboard-section .rounded-2xl {
  border-radius: 1rem;
}

.dashboard-section .rounded-xl {
  border-radius: 0.75rem;
}

.dashboard-section .rounded-lg {
  border-radius: 0.5rem;
}

.dashboard-section .rounded-3xl {
  border-radius: 1.5rem;
}

.dashboard-section .shadow-sm {
  box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
}

.dashboard-section .shadow-xl {
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
}

.dashboard-section .shadow-lg {
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
}

/* Transition utilities */
.dashboard-section .transition-all {
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.dashboard-section .transition-colors {
  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

.dashboard-section .transition-transform {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

/* Text utilities */
.dashboard-section .text-xs {
  font-size: 0.75rem;
  line-height: 1rem;
}

.dashboard-section .text-sm {
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.dashboard-section .text-lg {
  font-size: 1.125rem;
  line-height: 1.75rem;
}

.dashboard-section .text-xl {
  font-size: 1.25rem;
  line-height: 1.75rem;
}

.dashboard-section .text-3xl {
  font-size: 1.875rem;
  line-height: 2.25rem;
}

/* Font weight utilities */
.dashboard-section .font-medium {
  font-weight: 500;
}

.dashboard-section .font-bold {
  font-weight: 700;
}

.dashboard-section .font-black {
  font-weight: 900;
}

/* Text colors */
.dashboard-section .text-slate-400 {
  color: #94a3b8;
}

.dashboard-section .text-slate-500 {
  color: #64748b;
}

.dashboard-section .text-slate-600 {
  color: #475569;
}

.dashboard-section .text-slate-700 {
  color: #334155;
}

.dashboard-section .text-slate-800 {
  color: #1e293b;
}

.dashboard-section .text-white {
  color: #ffffff;
}

.dashboard-section .text-teal-500 {
  color: #14b8a6;
}

.dashboard-section .text-teal-600 {
  color: #0d9488;
}

/* Background colors */
.dashboard-section .bg-white {
  background-color: #ffffff;
}

.dashboard-section .bg-slate-50 {
  background-color: #f8fafc;
}

.dashboard-section .bg-slate-100 {
  background-color: #f1f5f9;
}

.dashboard-section .bg-teal-50 {
  background-color: #f0fdfa;
}

.dashboard-section .bg-teal-500 {
  background-color: #14b8a6;
}

/* Border colors */
.dashboard-section .border {
  border-width: 1px;
}

.dashboard-section .border-slate-100 {
  border-color: #f1f5f9;
}

.dashboard-section .border-slate-200 {
  border-color: #e2e8f0;
}

/* Hover states for quick links */
.dashboard-section .hover\\:border-teal-400:hover {
  border-color: #2dd4bf;
}

.dashboard-section .hover\\:border-blue-400:hover {
  border-color: #60a5fa;
}

.dashboard-section .hover\\:border-purple-400:hover {
  border-color: #c084fc;
}

.dashboard-section .hover\\:border-amber-400:hover {
  border-color: #fbbf24;
}

.dashboard-section .hover\\:bg-teal-500:hover {
  background-color: #14b8a6;
}

.dashboard-section .hover\\:bg-blue-500:hover {
  background-color: #3b82f6;
}

.dashboard-section .hover\\:bg-purple-500:hover {
  background-color: #a855f7;
}

.dashboard-section .hover\\:bg-amber-500:hover {
  background-color: #f59e0b;
}

.dashboard-section .hover\\:bg-slate-100:hover {
  background-color: #f1f5f9;
}

.dashboard-section .hover\\:bg-teal-600:hover {
  background-color: #0d9488;
}

/* Shadow hover effects */
.dashboard-section .hover\\:shadow-xl:hover {
  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
}

.dashboard-section .hover\\:shadow-lg:hover {
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
}

/* Group hover effects */
.dashboard-section .group:hover .group-hover\\:bg-teal-500 {
  background-color: #14b8a6;
}

.dashboard-section .group:hover .group-hover\\:text-white {
  color: #ffffff;
}

.dashboard-section .group:hover .group-hover\\:scale-150 {
  transform: scale(1.5);
}

/* Flex utilities */
.dashboard-section .flex {
  display: flex;
}

.dashboard-section .flex-col {
  flex-direction: column;
}

.dashboard-section .items-center {
  align-items: center;
}

.dashboard-section .justify-center {
  justify-content: center;
}

.dashboard-section .justify-between {
  justify-content: space-between;
}

.dashboard-section .gap-1 {
  gap: 0.25rem;
}

.dashboard-section .gap-2 {
  gap: 0.5rem;
}

.dashboard-section .gap-3 {
  gap: 0.75rem;
}

.dashboard-section .gap-4 {
  gap: 1rem;
}

.dashboard-section .gap-6 {
  gap: 1.5rem;
}

.dashboard-section .gap-8 {
  gap: 2rem;
}

/* Spacing utilities */
.dashboard-section .p-3 {
  padding: 0.75rem;
}

.dashboard-section .p-4 {
  padding: 1rem;
}

.dashboard-section .p-6 {
  padding: 1.5rem;
}

.dashboard-section .mb-1 {
  margin-bottom: 0.25rem;
}

.dashboard-section .mb-2 {
  margin-bottom: 0.5rem;
}

.dashboard-section .mb-4 {
  margin-bottom: 1rem;
}

.dashboard-section .mb-6 {
  margin-bottom: 1.5rem;
}

.dashboard-section .mb-8 {
  margin-bottom: 2rem;
}

.dashboard-section .mt-1 {
  margin-top: 0.25rem;
}

.dashboard-section .mt-2 {
  margin-top: 0.5rem;
}

.dashboard-section .mt-4 {
  margin-top: 1rem;
}

/* Width and height utilities */
.dashboard-section .w-2 {
  width: 0.5rem;
}

.dashboard-section .w-12 {
  width: 3rem;
}

.dashboard-section .w-16 {
  width: 4rem;
}

.dashboard-section .w-32 {
  width: 8rem;
}

.dashboard-section .w-full {
  width: 100%;
}

.dashboard-section .h-2 {
  height: 0.5rem;
}

.dashboard-section .h-12 {
  height: 3rem;
}

.dashboard-section .h-16 {
  height: 4rem;
}

.dashboard-section .h-32 {
  height: 8rem;
}

.dashboard-section .h-full {
  height: 100%;
}

/* Rounded full */
.dashboard-section .rounded-full {
  border-radius: 9999px;
}

/* Overflow hidden */
.dashboard-section .overflow-hidden {
  overflow: hidden;
}

/* Position absolute */
.dashboard-section .absolute {
  position: absolute;
}

.dashboard-section .top-0 {
  top: 0;
}

.dashboard-section .right-0 {
  right: 0;
}

.dashboard-section .-mr-16 {
  margin-right: -4rem;
}

.dashboard-section .-mt-16 {
  margin-top: -4rem;
}

/* Inline flex */
.dashboard-section .inline-flex {
  display: inline-flex;
}

/* Text decoration */
.dashboard-section .no-underline {
  text-decoration: none;
}

/* Uppercase tracking */
.dashboard-section .uppercase {
  text-transform: uppercase;
}

.dashboard-section .tracking-widest {
  letter-spacing: 0.1em;
}

.dashboard-section .tracking-\\[0\\.15em\\] {
  letter-spacing: 0.15em;
}

.dashboard-section .tracking-\\[0\\.2em\\] {
  letter-spacing: 0.2em;
}

/* Text align center */
.dashboard-section .text-center {
  text-align: center;
}

/* Inline block */
.dashboard-section .inline-block {
  display: inline-block;
}

/* Border radius utilities */
.dashboard-section .rounded {
  border-radius: 0.25rem;
}

.dashboard-section .rounded-full {
  border-radius: 9999px;
}

/* Padding utilities */
.dashboard-section .px-2 {
  padding-left: 0.5rem;
  padding-right: 0.5rem;
}

.dashboard-section .px-3 {
  padding-left: 0.75rem;
  padding-right: 0.75rem;
}

.dashboard-section .px-4 {
  padding-left: 1rem;
  padding-right: 1rem;
}

.dashboard-section .px-6 {
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.dashboard-section .py-0\\.5 {
  padding-top: 0.125rem;
  padding-bottom: 0.125rem;
}

.dashboard-section .py-2\\.5 {
  padding-top: 0.625rem;
  padding-bottom: 0.625rem;
}

.dashboard-section .py-4 {
  padding-top: 1rem;
  padding-bottom: 1rem;
}

.dashboard-section .pb-4 {
  padding-bottom: 1rem;
}

/* Space-y for children */
.dashboard-section .space-y-4 > * + * {
  margin-top: 1rem;
}

/* Capize */
.dashboard-section .capitalize {
  text-transform: capitalize;
}
