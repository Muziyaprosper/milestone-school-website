/**
 * Payroll Calculation Utilities for Zambian Schools
 * Handles NAPSA, PAYE, NHIMA and other statutory deductions
 * 
 * Zambia Tax Rates (Updated per User Requirements):
 * - NAPSA: 5% of gross salary (capped at ZMW 1,342 monthly, ceiling ZMW 26,840)
 * - NHIMA: 1% of basic salary
 * - PAYE: Progressive tax brackets (0%, 20%, 30%, 37%)
 */

// ===== Constants for Zambia Payroll =====

const NAPSA_CONFIG = {
  employeeRate: 0.05,
  // 5% employee contribution
  employerRate: 0.05,
  // 5% employer contribution
  monthlyCeiling: 26840,
  // Maximum monthly salary subject to NAPSA
  maxContribution: 1342 // Maximum contribution value
};
const NHIMA_CONFIG = {
  employeeRate: 0.01,
  // 1% employee contribution
  employerRate: 0.01 // 1% employer contribution
};
const PAYE_BRACKETS = [{
  min: 0,
  max: 5100,
  rate: 0
},
// 0% on first ZMW 5,100
{
  min: 5100,
  max: 7100,
  rate: 0.20
},
// 20% on next ZMW 2,000
{
  min: 7100,
  max: 9200,
  rate: 0.30
},
// 30% on next ZMW 2,100
{
  min: 9200,
  max: Infinity,
  rate: 0.37
} // 37% above ZMW 9,200
];

// ===== Type Definitions =====

// ===== Calculation Functions =====

/**
 * Calculate NAPSA deduction
 * Capped at ZMW 1,342 (ceiling ZMW 26,840)
 */
function calculateNapsa(grossSalary) {
  if (grossSalary > NAPSA_CONFIG.monthlyCeiling) {
    return NAPSA_CONFIG.maxContribution;
  }
  return grossSalary * NAPSA_CONFIG.employeeRate;
}

/**
 * Calculate NHIMA deduction (1% of basic salary)
 */
function calculateNhima(baseSalary) {
  return baseSalary * NHIMA_CONFIG.employeeRate;
}

/**
 * Calculate PAYE (Pay As You Earn) using progressive tax brackets
 */
function calculatePaye(grossSalary) {
  let totalTax = 0;
  let remainingIncome = grossSalary;
  for (const bracket of PAYE_BRACKETS) {
    if (remainingIncome <= bracket.min) break;
    const taxableInBracket = Math.min(remainingIncome - bracket.min, bracket.max - bracket.min);
    if (taxableInBracket > 0) {
      totalTax += taxableInBracket * bracket.rate;
    }
  }
  return Math.max(0, totalTax);
}

/**
 * Calculate Gross Salary from components
 */
function calculateGrossSalary(components) {
  return components.baseSalary + components.housingAllowance + components.transportAllowance + components.responsibilityAllowance + components.otherAllowances;
}

/**
 * Calculate Total Deductions (non-statutory)
 */
function calculateNonStatutoryDeductions(deductions) {
  return deductions.daysAbsentDeduction + deductions.advanceSalaryRepayment + deductions.loanRepayment + deductions.rentDeduction + deductions.schoolFeesDeduction + deductions.personalLevy + deductions.otherDeductions;
}

/**
 * Main Payroll Calculation Function
 * Computes all earnings, deductions, and net salary
 */
function calculatePayroll(salaryComponents, deductionComponents, leaveDaysTaken = 0, leaveDaysEntitled = 30) {
