function numberToWords(n) {
  const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
  const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
  const numToWords = num => {
    if (num === 0) return 'Zero';
    let words = '';
    if (num >= 1000000) {
      words += numToWords(Math.floor(num / 1000000)) + ' Million ';
      num %= 1000000;
    }
    if (num >= 1000) {
      words += numToWords(Math.floor(num / 1000)) + ' Thousand ';
      num %= 1000;
    }
    if (num >= 100) {
      words += ones[Math.floor(num / 100)] + ' Hundred ';
      num %= 100;
    }
    if (num >= 20) {
      words += tens[Math.floor(num / 10)] + ' ';
      num %= 10;
    }
    if (num > 0) {
      words += ones[num] + ' ';
    }
    return words.trim();
  };
  const wholePart = Math.floor(n);
  const fractionalPart = Math.round((n - wholePart) * 100);
  let result = numToWords(wholePart);
  if (fractionalPart > 0) {
    result += ' Kwacha and ' + numToWords(fractionalPart) + ' Ngwee';
  } else {
    result += ' Kwacha';
  }
  return result;
}
